# Valgrind suppression file for GNU readline and libtinfo reachable leaks.
# These libraries intentionally keep global state alive for the
# process lifetime without calling free() at exit. This is expected
# behavior, not a bug in the shell.
#
# Usage:
#   valgrind --suppressions=readline.supp --leak-check=full ./42sh
#
# Or to also hide "still reachable" in the summary:
#   valgrind --suppressions=readline.supp --leak-check=full \
#            --show-leak-kinds=definite,indirect,possible ./42sh

# ── libreadline ─────────────────────────────────────────────────────────────
# Covers: malloc → xmalloc/rl_*/readline_internal_* → ...
#         malloc → rl_initialize/rl_set_prompt/rl_redisplay → ...

{
   readline_malloc_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:malloc
   obj:*/libreadline.so*
   ...
}

{
   readline_realloc_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:realloc
   obj:*/libreadline.so*
   ...
}

{
   readline_calloc_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:calloc
   obj:*/libreadline.so*
   ...
}

# ── libtinfo (terminal capability database) ──────────────────────────────────
# Covers: calloc/malloc/realloc → _nc_setupterm/_nc_read_termtype/... → ...

{
   libtinfo_malloc_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:malloc
   obj:*/libtinfo.so*
   ...
}

{
   libtinfo_calloc_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:calloc
   obj:*/libtinfo.so*
   ...
}

{
   libtinfo_realloc_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:realloc
   obj:*/libtinfo.so*
   ...
}

# ── libc helpers called on behalf of libtinfo ────────────────────────────────
# Covers: malloc → strdup → _nc_setupterm/_nc_tiparm/... (loss records 3,10,12,20)

{
   libtinfo_strdup_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:malloc
   fun:strdup
   obj:*/libtinfo.so*
   ...
}

# Covers: malloc → tsearch → libtinfo_??? → _nc_tiparm/... (loss record 14)

{
   libtinfo_tsearch_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:malloc
   fun:tsearch
   obj:*/libtinfo.so*
   ...
}
